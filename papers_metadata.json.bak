    "venue": "Proceedings of the International Conference on Information Economy, Data Modeling and Cloud Computing, ICIDC 2022, 17-19 June 2022, Qingdao, China",
    "is_oa": true,
    "pdf_url": "http://eudl.eu/pdf/10.4108/eai.17-6-2022.2322686",
